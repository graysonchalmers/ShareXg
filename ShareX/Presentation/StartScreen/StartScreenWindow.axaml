<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ShareX.StartScreenWindow"
        Title="Welcome to ShareXg"
        Width="420" SizeToContent="Height"
        CanResize="False"
        SystemDecorations="BorderOnly"
        Background="#16181D"
        WindowStartupLocation="CenterScreen">
    <Border BorderBrush="#3A3F4B" BorderThickness="1">
        <Grid RowDefinitions="26,*,Auto">
            <!-- Winamp-style title strip -->
            <Border Grid.Row="0" Background="#22252D" PointerPressed="OnTitlePointerPressed">
                <TextBlock Text="SHAREXG" Margin="10,0" VerticalAlignment="Center"
                           FontSize="11" FontWeight="Bold" LetterSpacing="3" Foreground="#F2A33A"/>
            </Border>
            <Grid Grid.Row="1" ColumnDefinitions="Auto,*" Margin="18,14,18,0">
                <Image x:Name="LogoImage" Width="72" Height="72" VerticalAlignment="Top"/>
                <StackPanel Grid.Column="1" Margin="16,0,0,0" Spacing="4">
                    <TextBlock Text="Welcome to ShareXg" FontSize="18" FontWeight="Bold" Foreground="#EDEFF3"/>
                    <TextBlock Text="A remix of ShareX (open source, GPL-3)" FontSize="12" Foreground="#A9AFBC"/>
                    <HyperlinkButton Padding="0" FontSize="12" Content="getsharex.com" NavigateUri="https://getsharex.com" Foreground="#3AD1E0"/>
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="By" FontSize="12" Foreground="#A9AFBC" VerticalAlignment="Center"/>
                        <HyperlinkButton Padding="0" FontSize="12" Content="graysonchalmers.com" NavigateUri="https://graysonchalmers.com" Foreground="#3AD1E0"/>
                    </StackPanel>
                    <TextBlock x:Name="ContactText" FontSize="12" Foreground="#A9AFBC"/>
                    <TextBlock x:Name="VersionStamp" FontSize="11" Foreground="#F2A33A" Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>
            <Button Grid.Row="2" Content="Close" HorizontalAlignment="Right" Margin="0,0,14,12" Padding="18,4"
                    Background="#F2A33A" Foreground="#16181D" FontWeight="Bold" Click="OnGetStartedClick"/>
        </Grid>
    </Border>
</Window>
